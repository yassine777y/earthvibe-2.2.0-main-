# PostgreSQL connection used by the provenance cache (falls back to in-memory cache if unreachable).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Comma-separated list of EXTRA origins allowed to call /api/* from a browser.
# Leave empty for same-origin only (recommended). Example: https://jukebox.example.org
CORS_ALLOWED_ORIGINS=
